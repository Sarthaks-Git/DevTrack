NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/devtrack
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/devtrack_test
JWT_SECRET=replace-with-at-least-32-random-characters
CLIENT_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
ACCESS_TOKEN_TTL_MINUTES=10
REFRESH_TOKEN_TTL_DAYS=30
# Reverse-proxy hops to trust for client IPs (0 when not behind a proxy)
TRUST_PROXY=0
# Rate-limit counters: memory (single instance) or mongo (shared across instances)
RATE_LIMIT_STORE=memory
# GitHub App (optional). Leave blank to hide "Connect GitHub". Create the app at
# github.com/settings/apps; see docs/DEPLOYMENT.md. Never commit real values.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
# Defaults to CLIENT_ORIGIN + /api/integrations/github/callback
GITHUB_CALLBACK_URL=
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# AI (optional). Leave ANTHROPIC_API_KEY empty to turn AI features off.
ANTHROPIC_API_KEY=
# Server-side cap on total AI spend per calendar month (UTC), in USD. Also set a limit in the Anthropic Console.
AI_MONTHLY_BUDGET_USD=4
# Plans. Free uses the cheapest model; Pro uses a stronger one. Limits are AI actions per user per month.
AI_FREE_MONTHLY_LIMIT=100
AI_PRO_MONTHLY_LIMIT=300
# Optional model overrides (default claude-haiku-5-5 for Free, claude-sonnet-5-5 for Pro).
AI_MODEL_FREE=
AI_MODEL_PRO=

# Social sign-in (optional; each provider is on when both values are set). Callback URLs to register:
#   <CLIENT_ORIGIN>/api/auth/oauth/google/callback, .../github/callback, .../linkedin/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# A separate GitHub OAuth App used only for sign-in (not the repository GitHub App).
GITHUB_LOGIN_CLIENT_ID=
GITHUB_LOGIN_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Email (required in production: sign-up needs email verification). Brevo -> SMTP & API -> API Keys.
# EMAIL_FROM must be a sender verified in Brevo.
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=DevTrack

# Rejects passwords found in known data breaches (Have I Been Pwned; only the first 5
# characters of the password's SHA-1 hash leave the server). Set to off to disable.
PASSWORD_BREACH_CHECK=on
