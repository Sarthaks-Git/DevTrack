NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/devtrack
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/devtrack_test
JWT_SECRET=replace-with-at-least-32-random-characters
CLIENT_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
ACCESS_TOKEN_TTL_MINUTES=10
REFRESH_TOKEN_TTL_DAYS=30
# Reverse-proxy hops to trust for client IPs (0 when not behind a proxy)
TRUST_PROXY=0
# Rate-limit counters: memory (single instance) or mongo (shared across instances)
RATE_LIMIT_STORE=memory
# GitHub App (optional). Leave blank to hide "Connect GitHub". Create the app at
# github.com/settings/apps; see docs/DEPLOYMENT.md. Never commit real values.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
# Defaults to CLIENT_ORIGIN + /api/integrations/github/callback
GITHUB_CALLBACK_URL=
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
